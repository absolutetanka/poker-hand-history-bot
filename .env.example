DISCORD_BOT_TOKEN=
# Optional fixed channel IDs to watch (comma-separated). Servers normally pick
# channels with /setup add instead.
HAND_HISTORY_CHANNEL_IDS=

# Folder for the SQLite settings database. On Railway, mount a volume at /data
# and set DATA_DIR=/data, or /setup choices are lost on every redeploy.
DATA_DIR=./data

# Rate limits protecting the free LLM/STT quotas (0 = no limit)
RATE_LIMIT_USER_PER_HOUR=10
RATE_LIMIT_GUILD_PER_DAY=200

# React with 👀 / ✅ / ⚠️ / ❌ while processing (true|false)
USE_REACTIONS=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
# json_schema (strict structured output) | json_object | none
# Fall back to json_object/none if the free router reports no endpoints support json_schema.
OPENROUTER_RESPONSE_FORMAT=json_schema
# Comma-separated models OpenRouter falls back to (in order) when the primary
# errors or is rate-limited. openrouter/free as the last entry = any free model.
OPENROUTER_FALLBACK_MODELS=openrouter/free
# off = skip slow reasoning ("thinking") models; replies in seconds instead of ~50s
OPENROUTER_REASONING=off
OPENROUTER_TIMEOUT_MS=60000
# Retries use exponential backoff starting at OPENROUTER_RETRY_BASE_DELAY_MS.
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_DELAY_MS=2000

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Discord Poker Hand History Bot

# Speech-to-text: none | browser_bridge | openai_whisper
STT_PROVIDER=none
# browser_bridge: URL of your STT worker. openai_whisper: any OpenAI-compatible
# /audio/transcriptions URL (defaults to https://api.openai.com/v1/audio/transcriptions)
STT_ENDPOINT=
STT_API_KEY=
# openai_whisper only (e.g. whisper-1, or whisper-large-v3 on Groq)
STT_MODEL=whisper-1

LOG_LEVEL=info
